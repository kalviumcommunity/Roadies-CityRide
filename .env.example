# Roadies-CityRide configuration
# Copy this file to .env and adjust values as needed.

# Environment: local | development | staging | production
ROADIES_ENVIRONMENT=local

# Project root directory (relative to repo root or absolute)
# ROADIES_PROJECT_DIR=.

# Data directories (relative to project dir or absolute)
# ROADIES_RAW_DATA_DIR=data/raw
# ROADIES_PROCESSED_DATA_DIR=data/processed
# ROADIES_SYNTHETIC_DATA_DIR=data/synthetic

# SQLite database URL
# ROADIES_DATABASE_URL=sqlite:///data/roadies.db

# Random seed for reproducible synthetic data generation
# ROADIES_RANDOM_SEED=42
